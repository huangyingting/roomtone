{
  "name": "roomtone",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/model.test.ts tests/publish.test.mjs",
    "test:e2e": "playwright test",
    "serve": "node scripts/serve.mjs",
    "publish": "node scripts/publish.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "0.187.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.4.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
